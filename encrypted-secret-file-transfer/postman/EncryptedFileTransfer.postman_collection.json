            ],
            "url": {
              "raw": "{{baseUrl}}/api/permissions/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "permissions",
                "{{fileId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Bob sees shared file",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files?scope=shared",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "shared"
                }
              ]
            }
          }
        },
        {
          "name": "Download (Bob) -> 200 decrypted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
