                  "pm.collectionVariables.set('tokenBob', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Bob@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
