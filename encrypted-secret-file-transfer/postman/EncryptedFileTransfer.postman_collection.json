            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "download"
              ],
              "query": []
            }
          }
        }
