            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "download"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Revoke (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/permissions/{{permissionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "permissions",
                "{{permissionId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Download after revoke (Bob) -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
