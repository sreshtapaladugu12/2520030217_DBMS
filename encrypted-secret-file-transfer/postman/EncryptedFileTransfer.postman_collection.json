    {
      "name": "2 Files",
      "item": [
        {
          "name": "Upload (Alice) - pick any .txt in the body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('fileId', pm.response.json().file.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "upload"
              ],
              "query": []
            }
          }
        },
        {
          "name": "List (Alice)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files?scope=all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "all"
                }
              ]
            }
          }
        },
        {
          "name": "Details (Alice)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Download BEFORE share (Bob) -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "{{fileId}}",
                "download"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "3 Permissions",
      "item": [
        {
          "name": "Share with Bob (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('permissionId', pm.response.json().permission.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"{{fileId}}\",\n  \"email\": \"bob@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/permissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "permissions"
              ],
              "query": []
            }
          }
        },
        {
          "name": "List permissions (Alice)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlice}}"
