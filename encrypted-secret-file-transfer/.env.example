# Copy to .env  (cp .env.example .env)  -- never commit .env
NODE_ENV=development

# ---- Gateway ----
PORT=4000

# ---- Service URLs (used by the gateway and by service-to-service calls) ----
AUTH_SERVICE_URL=http://localhost:4101
FILE_SERVICE_URL=http://localhost:4102
PERMISSION_SERVICE_URL=http://localhost:4103
AUDIT_SERVICE_URL=http://localhost:4104

# ---- Service ports ----
AUTH_SERVICE_PORT=4101
FILE_SERVICE_PORT=4102
PERMISSION_SERVICE_PORT=4103
AUDIT_SERVICE_PORT=4104

# ---- Database (local MongoDB or an Atlas connection string) ----
MONGODB_URI=mongodb://127.0.0.1:27017/encrypted_file_transfer

# ---- Secrets (change for anything other than a classroom demo) ----
JWT_SECRET=change_this_in_real_environment
JWT_EXPIRES_IN=8h
# 64 hex chars (raw 256-bit key) OR any long passphrase (a key is derived with scrypt)
FILE_ENCRYPTION_KEY=change_this_in_real_environment
# Shared secret that protects service-to-service /internal endpoints
INTERNAL_API_KEY=change_this_internal_key

# ---- File handling ----
MAX_FILE_SIZE_MB=10
# Encrypted blobs live here. Never served statically.
FILE_STORAGE_DIR=./uploads/encrypted

# ---- Optional ----
LOGIN_RATE_LIMIT_PER_MIN=30
